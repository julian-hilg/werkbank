{
  "name": "werkbank",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "starter"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:app": "npm run dev -w starter",
    "build": "npm run build -w @werkbank/framework && npm run build -w starter",
    "build:framework": "npm run build -w @werkbank/framework",
    "test": "vitest run",
    "check": "node scripts/check.mjs && node scripts/check-bridge.mjs",
    "perf": "node scripts/perf.mjs",
    "typecheck": "tsc -p packages/framework && tsc -p starter && tsc -p packages/bridge",
    "bridge": "node packages/bridge/src/server.js --hub --home starter",
    "new:tool": "node scripts/new-tool.mjs",
    "new:app": "node scripts/create-app.mjs",
    "skill:install": "node scripts/install-skill.mjs",
    "promote:element": "node scripts/promote-element.mjs",
    "pack": "node scripts/pack.mjs",
    "check:app": "node scripts/check-app.mjs"
  },
  "devDependencies": {
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright": "^1.65.1",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^5.1.0"
  },
  "version": "0.7.0",
  "license": "MIT",
  "author": "Julian Hilg",
  "homepage": "https://github.com/julian-hilg/werkbank#readme",
  "description": "Dockable workspaces that people and AI agents operate together.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julian-hilg/werkbank.git"
  }
}
